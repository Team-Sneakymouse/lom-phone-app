{
  "expo": {
    "name": "Lords of Minecraft",
    "slug": "lom-phone",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lomphone",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tv.rawb.lomphone",
      "infoPlist": {
        "NSMotionUsageDescription": "Lords of Minecraft reads your step count to sync walking progress for in-game rewards.",
        "NSHealthShareUsageDescription": "Lords of Minecraft reads your step count to sync walking progress for in-game rewards.",
        "NSHealthUpdateUsageDescription": "Lords of Minecraft does not write health data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F3D34",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "tv.rawb.lomphone",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E1C1A"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C4A35A",
          "defaultChannel": "jobs"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Lords of Minecraft reads your step count to sync walking progress for in-game rewards."
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Lords of Minecraft reads your step count to sync walking progress for in-game rewards.",
          "NSHealthUpdateUsageDescription": "Lords of Minecraft does not write health data.",
          "background": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "21ba1aba-8725-495a-853b-1581dd5aa43c"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "team-sneakymouse"
  }
}
